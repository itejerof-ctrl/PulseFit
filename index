let userHeight = 180;

function navyBF(waist, neck, height){
  if(!waist || !neck || !height) return null;
  if(waist - neck <= 0) return null;
  const bf = 495 / (1.0324 - 0.19077 * Math.log10(waist - neck) + 0.15456 * Math.log10(height)) - 450;
  if(!isFinite(bf)) return null;
  return Math.round(bf * 10) / 10;
}

const measureSamples = [
  { daysAgo: 150, weight: 82.4, waist: 86.5, neck: 39.5 },
  { daysAgo: 120, weight: 81.6, waist: 85.8, neck: 39.4 },
  { daysAgo: 90,  weight: 80.5, waist: 84.5, neck: 39.2 },
  { daysAgo: 60,  weight: 79.6, waist: 83.2, neck: 38.9 },
  { daysAgo: 30,  weight: 78.9, waist: 82.1, neck: 38.6 },
  { daysAgo: 7,   weight: 78.4, waist: 81.4, neck: 38.4 }
];

let bodyRecords = measureSamples.map(s => {
  const h = userHeight;
  return {
    date: isoDate(addDays(TODAY, -s.daysAgo)),
    weight: s.weight,
    height: h,
    waist: s.waist,
    neck: s.neck,
    fat: navyBF(s.waist, s.neck, h)
  };
});

let currentMeasureMetric = 'weight';
let measurePeriod = 90;

function setMetric(metric){
  currentMeasureMetric = metric;
  document.querySelectorAll('#metricChips button').forEach(b => {
    b.classList.toggle('on', b.dataset.metric === metric);
  });
  renderMeasureChart();
}

function setMeasurePeriod(btn){
  measurePeriod = parseInt(btn.dataset.period, 10);
  document.querySelectorAll('#measurePeriodChips button').forEach(b => {
    b.classList.toggle('on', b === btn);
  });
  renderMeasureChart();
  renderMeasureRecords();
}

function filteredRecords(){
  const arr = [...bodyRecords].sort((a,b) => a.date.localeCompare(b.date));
  if(measurePeriod === 0) return arr;
  const cutoff = isoDate(addDays(TODAY, -measurePeriod));
  return arr.filter(r => r.date >= cutoff);
}

function periodLabel(){
  if(measurePeriod === 0) return 'todo el tiempo';
  if(measurePeriod === 90) return 'últimos 3 meses';
  if(measurePeriod === 180) return 'últimos 6 meses';
  if(measurePeriod === 365) return 'último año';
  return 'últimos ' + measurePeriod + ' días';
}

function renderMeasureChart(){
  const records = filteredRecords();
  const metric = currentMeasureMetric;
  const metricLabels = { weight:'Peso (kg)', fat:'Grasa (%)', waist:'Cintura (cm)', neck:'Cuello (cm)' };
  const metricColors = { weight:'#3B82F6', fat:'#8B5CF6', waist:'#22D3EE', neck:'#F59E0B' };
  const color = metricColors[metric];

  document.getElementById('measureChartTitle').textContent = 'Evolución: ' + metricLabels[metric];
  document.getElementById('measureChartSub').textContent = 'Periodo: ' + periodLabel();

  const points = records
    .filter(r => r[metric] != null)
    .map(r => ({ date: r.date, value: r[metric] }));

  const svgEl = document.getElementById('measureChartSvg');
  const legendEl = document.getElementById('measureChartLegend');
  const changeEl = document.getElementById('measureChange');

  if (points.length < 2) {
    svgEl.innerHTML = `<text x="150" y="70" text-anchor="middle" fill="#8A8A9E" font-size="12" font-weight="600">Añade más registros en este periodo</text>`;
    legendEl.innerHTML = '';
    changeEl.textContent = '—';
    changeEl.style.background = 'rgba(139,92,246,.16)';
    changeEl.style.color = '#C4B5FD';
    changeEl.style.borderColor = 'rgba(139,92,246,.35)';
    return;
  }

  const values = points.map(p => p.value);
  let min = Math.min(...values);
  let max = Math.max(...values);
  const padding = (max - min) * 0.15 || 1;
  min -= padding;
  max += padding;
  const range = max - min || 1;

  const width = 300, height = 140;
  const marginX = 30, marginY = 20;
  const chartW = width - marginX * 2;
  const chartH = height - marginY * 2;

  const xForIndex = (i) => marginX + (i / (points.length - 1)) * chartW;
  const yForValue = (v) => marginY + chartH - ((v - min) / range) * chartH;

  let pathD = '';
  points.forEach((p, i) => {
    const x = xForIndex(i);
    const y = yForValue(p.value);
    pathD += (i === 0 ? `M${x},${y}` : ` L${x},${y}`);
  });

  let svgHtml = `<defs>
    <linearGradient id="measureGrad" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="${color}" stop-opacity=".35"/>
      <stop offset="100%" stop-color="${color}" stop-opacity="0"/>
    </linearGradient>
  </defs>`;

  const firstX = xForIndex(0);
  const lastX = xForIndex(points.length - 1);
  const areaPath = `${pathD} L${lastX},${height - marginY} L${firstX},${height - marginY} Z`;
  svgHtml += `<path d="${areaPath}" fill="url(#measureGrad)"/>`;
  svgHtml += `<path d="${pathD}" fill="none" stroke="${color}" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>`;

  points.forEach((p, i) => {
    const x = xForIndex(i);
    const y = yForValue(p.value);
    svgHtml += `<circle cx="${x}" cy="${y}" r="6" fill="#0E0E16" stroke="${color}" stroke-width="2" data-chart-value="${p.value}" data-chart-label="${p.date}" class="interactive-point" style="cursor:pointer"/>`;
  });

  const fmtDate = (d) => parseISO(d).toLocaleDateString('es-ES', { day:'2-digit', month:'short' });
  svgHtml += `<text x="${firstX}" y="${height - 4}" text-anchor="middle" fill="#5C5C70" font-size="9" font-weight="700" font-family="inherit">${fmtDate(points[0].date)}</text>`;
  svgHtml += `<text x="${lastX}" y="${height - 4}" text-anchor="middle" fill="#5C5C70" font-size="9" font-weight="700" font-family="inherit">${fmtDate(points[points.length - 1].date)}</text>`;

  svgEl.innerHTML = svgHtml;
  svgEl.querySelectorAll('.interactive-point').forEach(pt=>pt.addEventListener('click',()=>{
    svgEl.querySelectorAll('.interactive-point').forEach(p=>p.classList.remove('selected'));
    svgEl.querySelectorAll('.chart-value-label').forEach(el=>el.remove());
    pt.classList.add('selected');
    const x = Number(pt.getAttribute('cx')), y = Number(pt.getAttribute('cy'));
    const value = pt.getAttribute('data-chart-value');
    const label = document.createElementNS('http://www.w3.org/2000/svg','text');
    label.setAttribute('x',x); label.setAttribute('y',Math.max(14,y-13));
    label.setAttribute('text-anchor','middle'); label.setAttribute('fill','#FFFFFF');
    label.setAttribute('font-size','10'); label.setAttribute('font-weight','800');
    label.setAttribute('font-family','inherit'); label.setAttribute('class','chart-value-label');
    label.textContent = value + (metric === 'weight' ? ' kg' : metric === 'fat' ? ' %' : ' cm');
    svgEl.appendChild(label);
  }));

  const firstVal = points[0].value;
  const lastVal = points[points.length - 1].value;
  const diff = lastVal - firstVal;
  const diffStr = (diff >= 0 ? '+' : '') + diff.toFixed(1);
  const unit = metric === 'weight' ? ' kg' : metric === 'fat' ? ' %' : ' cm';

  changeEl.textContent = diffStr + unit;
  changeEl.style.background = diff >= 0 ? 'rgba(34,197,94,.16)' : 'rgba(244,63,94,.16)';
  changeEl.style.color = diff >= 0 ? '#4ADE80' : '#FDA4AF';
  changeEl.style.borderColor = diff >= 0 ? 'rgba(34,197,94,.35)' : 'rgba(244,63,94,.35)';

  legendEl.innerHTML = `
    <div class="cl">Primer registro<b>${firstVal}${unit}</b></div>
    <div class="cl">Último registro<b>${lastVal}${unit}</b></div>
    <div class="cl">Cambio<b class="${diff >= 0 ? 'up' : 'down'}">${diffStr}${unit}</b></div>
  `;
}

function renderMeasureRecords(){
  const container = document.getElementById('measureRecordsList');
  if (!container) return;
  const sorted = filteredRecords().sort((a,b) => b.date.localeCompare(a.date));
  if (!sorted.length) {
    container.innerHTML = `<div class="sheet-empty" style="background:var(--card);border:1px solid var(--line);border-radius:16px">No hay registros en este periodo.</div>`;
    return;
  }
  container.innerHTML = sorted.map(r => `
    <div class="measure-record">
      <div class="mr-date">${parseISO(r.date).toLocaleDateString('es-ES', { day:'2-digit', month:'short', year:'numeric' })}</div>
      <div class="mr-values">
        <div class="mr-val">Peso<b>${r.weight != null ? r.weight + ' kg' : '—'}</b></div>
        <div class="mr-val">Grasa<b>${r.fat != null ? r.fat + ' %' : '—'}</b></div>
        <div class="mr-val">Cintura<b>${r.waist != null ? r.waist + ' cm' : '—'}</b></div>
        <div class="mr-val">Cuello<b>${r.neck != null ? r.neck + ' cm' : '—'}</b></div>
      </div>
    </div>
  `).join('');
}

function initMeasureDate(){
  const input = document.getElementById('measureDate');
  const display = document.getElementById('measureDateDisplay');
  input.value = TODAY_ISO;
  display.textContent = formatDateDisplay(TODAY_ISO);
}

function onMeasureDateChange(){
  const input = document.getElementById('measureDate');
  document.getElementById('measureDateDisplay').textContent =
    input.value ? formatDateDisplay(input.value) : 'Selecciona fecha';
}

function openMeasureDatePicker(){
  const input = document.getElementById('measureDate');
  if (typeof input.showPicker === 'function') {
    try { input.showPicker(); return; } catch(e){ /* fallback */ }
  }
  input.focus();
  input.click();
}

function updateBFPreview(){
  const height = parseFloat(document.getElementById('measureHeight').value);
  const waist = parseFloat(document.getElementById('measureWaist').value);
  const neck = parseFloat(document.getElementById('measureNeck').value);
  const bf = navyBF(waist, neck, height);
  document.getElementById('bfPreviewValue').textContent = bf != null ? bf + ' %' : '—';
}

function addMeasureRecord(){
  const dateInput = document.getElementById('measureDate');
  const date = dateInput.value || TODAY_ISO;
  const weight = parseFloat(document.getElementById('measureWeight').value);
  const height = parseFloat(document.getElementById('measureHeight').value) || userHeight;
  const waistRaw = parseFloat(document.getElementById('measureWaist').value);
  const neckRaw = parseFloat(document.getElementById('measureNeck').value);
  const waist = isNaN(waistRaw) ? null : waistRaw;
  const neck = isNaN(neckRaw) ? null : neckRaw;

  if (isNaN(weight)) { toast('Introduce el peso'); return; }

  userHeight = height;
  const fat = navyBF(waist, neck, height);

  const rec = { date, weight, height, waist, neck, fat };
  const existing = bodyRecords.findIndex(r => r.date === date);
  if (existing >= 0) bodyRecords[existing] = rec;
  else bodyRecords.push(rec);

  document.getElementById('measureWeight').value = '';
  document.getElementById('measureWaist').value = '';
  document.getElementById('measureNeck').value = '';
  updateBFPreview();

  renderMeasureChart();
  renderMeasureRecords();
  toast('Registro guardado · ' + formatDateDisplay(date));
}

/* ============================================================
   CALENDARIO
============================================================ */
const workoutNames = [
  'DÍA A · Torso / Cuádriceps',
  'DÍA B · Espalda / Isquios',
  'PUSH · Pecho / Hombros',
  'PULL · Espalda / Bíceps',
  'LEGS · Cuádriceps / Isquios'
];
const workoutOffsets = [0,2,4,6,9,11,13,16,18,20,23,25,27,30,33,35,38,40,43,46,49,52,55,58,61,64,67,70];
let workoutLog = workoutOffsets.map((off, i) => {
  const d = addDays(TODAY, -off);
  return {
    date: isoDate(d),
    name: workoutNames[i % workoutNames.length],
    duration: 40 + (i * 7) % 25,
    volume: 3200 + (i * 137) % 2200
  };
});

let calCursor = new Date(TODAY.getFullYear(), TODAY.getMonth(), 1);
let selectedCalDate = null;

function calShift(delta){
  calCursor = new Date(calCursor.getFullYear(), calCursor.getMonth() + delta, 1);
  renderCalendar();
}

function selectCalDay(iso){
  selectedCalDate = iso;
  renderCalendar();
}

function renderCalendar(){
  const y = calCursor.getFullYear();
  const m = calCursor.getMonth();

  const monthNames = ['enero','febrero','marzo','abril','mayo','junio','julio','agosto','septiembre','octubre','noviembre','diciembre'];
  const label = monthNames[m].charAt(0).toUpperCase() + monthNames[m].slice(1) + ' ' + y;
  document.getElementById('calMonthLabel').textContent = label;

  const wMap = {};
  workoutLog.forEach(w => { wMap[w.date] = w; });

  const firstDay = new Date(y, m, 1);
  const startOffset = (firstDay.getDay() + 6) % 7;
  const daysInMonth = new Date(y, m + 1, 0).getDate();
  const prevMonthDays = new Date(y, m, 0).getDate();

  const cells = [];
  ['L','M','X','J','V','S','D'].forEach(d => {
    cells.push(`<div class="cal-dow">${d}</div>`);
  });

  for (let i = startOffset - 1; i >= 0; i--) {
    cells.push(`<div class="cal-day other">${prevMonthDays - i}</div>`);
  }

  for (let d = 1; d <= daysInMonth; d++) {
    const iso = `${y}-${String(m + 1).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
    const w = wMap[iso];
    const cls = ['cal-day'];
    if (iso === TODAY_ISO) cls.push('today');
    if (w) cls.push('workout');
    if (selectedCalDate === iso) cls.push('selected');
    const click = w ? `onclick="selectCalDay('${iso}')"` : '';
    cells.push(`<div class="${cls.join(' ')}" ${click}>${d}${w ? '<span class="cal-dot"></span>' : ''}</div>`);
  }

  const used = 7 + startOffset + daysInMonth;
  const remaining = (7 - (used % 7)) % 7;
  for (let i = 1; i <= remaining; i++) {
    cells.push(`<div class="cal-day other">${i}</div>`);
  }

  document.getElementById('calGrid').innerHTML = cells.join('');

  const monthWorkouts = workoutLog.filter(w => {
    const d = parseISO(w.date);
    return d.getFullYear() === y && d.getMonth() === m;
  });
  const totalVol = monthWorkouts.reduce((s, w) => s + w.volume, 0);
  const totalMin = monthWorkouts.reduce((s, w) => s + w.duration, 0);
  document.getElementById('calSummary').innerHTML = `
    <div class="hm"><b>${monthWorkouts.length}</b><span>ENTRENOS</span></div>
    <div class="hm"><b>${(totalVol / 1000).toFixed(1)}k kg</b><span>VOLUMEN</span></div>
    <div class="hm"><b>${Math.floor(totalMin / 60)}h ${totalMin % 60}m</b><span>TIEMPO</span></div>
  `;

  renderCalDetail();
}

function renderCalDetail(){
  const el = document.getElementById('calDetail');
  if (!selectedCalDate) {
    el.innerHTML = `<div class="card" style="margin-top:14px;text-align:center;color:var(--muted);font-size:12px;font-weight:600;padding:18px">
      Toca un día marcado para ver el entrenamiento
    </div>`;
    return;
  }
  const w = workoutLog.find(x => x.date === selectedCalDate);
  if (!w) { el.innerHTML = ''; return; }

  const d = parseISO(selectedCalDate);
  el.innerHTML = `
    <div class="card" style="margin-top:14px">
      <div class="hist-top">
        <div>
          <h3>${escapeHtml(w.name)}</h3>
          <div class="date">${d.toLocaleDateString('es-ES', { weekday:'long', day:'numeric', month:'long' })}</div>
        </div>
        <div class="pr-badge">${w.duration} min</div>
      </div>
      <div class="hist-metrics">
        <div class="hm"><b>${w.duration}:00</b><span>TIEMPO</span></div>
        <div class="hm"><b>${w.volume.toLocaleString('es-ES')} kg</b><span>VOLUMEN</span></div>
      </div>
    </div>
  `;
}

/* ============================================================
   UTILIDADES
============================================================ */
function escapeHtml(str){
  return String(str)
    .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
    .replace(/"/g,'&quot;').replace(/'/g,'&#39;');
}

/* ============================================================
   DATOS LOCALES + SINCRONIZACIÓN GOOGLE SHEETS
============================================================ */
const LOCAL_DATA_KEY = 'pulsefit-local-v2';
const GOOGLE_SCRIPT_URL = 'PEGA_AQUI_TU_URL_DE_APPS_SCRIPT_TERMINADA_EN_EXEC';

let syncTimeout = null;

function getAppDataPayload() {
  return {
    version: 2,
    updatedAt: new Date().toISOString(),
    exercises,
    exerciseIdSeq,
    profile,
    workoutLog,
    bodyRecords,
    userHeight,
    folders,
    folderIdSeq,
    routineExercises
  };
}

function applyAppData(d) {
  if (!d || d.status === 'empty') return;
  if (Array.isArray(d.exercises)) exercises = d.exercises;
  if (Number.isFinite(d.exerciseIdSeq)) exerciseIdSeq = d.exerciseIdSeq;
  if (d.profile && typeof d.profile.name === 'string') profile = d.profile;
  if (Array.isArray(d.workoutLog)) workoutLog = d.workoutLog;
  if (Array.isArray(d.bodyRecords)) bodyRecords = d.bodyRecords;
  if (Number.isFinite(d.userHeight)) userHeight = d.userHeight;
  if (Array.isArray(d.folders)) folders = d.folders;
  if (Number.isFinite(d.folderIdSeq)) folderIdSeq = d.folderIdSeq;
  if (Array.isArray(d.routineExercises)) routineExercises = d.routineExercises;
}

function persistLocalData() {
  try {
    const data = getAppDataPayload();
    localStorage.setItem(LOCAL_DATA_KEY, JSON.stringify(data));
    scheduleCloudSync(data);
  } catch (err) {
    toast('Almacenamiento lleno. Reduce el tamaño de las imágenes.');
  }
}

// Espera 1.5s tras el último cambio antes de enviar a Google Sheets
function scheduleCloudSync(data) {
  if (!GOOGLE_SCRIPT_URL || GOOGLE_SCRIPT_URL.includes('PEGA_AQUI')) return;
  clearTimeout(syncTimeout);
  syncTimeout = setTimeout(() => syncToGoogleSheets(data), 1500);
}

async function syncToGoogleSheets(data) {
  try {
    // Usamos text/plain para evitar preflight CORS (OPTIONS) que Apps Script rechaza
    await fetch(GOOGLE_SCRIPT_URL, {
      method: 'POST',
      headers: { 'Content-Type': 'text/plain;charset=utf-8' },
      body: JSON.stringify(data || getAppDataPayload())
    });
    console.log('Sincronizado con Google Sheets');
  } catch (err) {
    console.warn('Error sincronizando con Google Sheets (modo offline):', err);
  }
}

function restoreLocalData() {
  try {
    const raw = localStorage.getItem(LOCAL_DATA_KEY);
    if (!raw) return;
    applyAppData(JSON.parse(raw));
  } catch (e) {
    console.warn('No se pudieron restaurar los datos locales', e);
  }
}

async function pullFromGoogleSheets() {
  if (!GOOGLE_SCRIPT_URL || GOOGLE_SCRIPT_URL.includes('PEGA_AQUI')) return;
  try {
    const res = await fetch(GOOGLE_SCRIPT_URL);
    const cloudData = await res.json();
    if (cloudData && cloudData.exercises) {
      applyAppData(cloudData);
      localStorage.setItem(LOCAL_DATA_KEY, JSON.stringify(cloudData));
      // Refrescar vistas con los datos descargados
      renderFolderScroll();
      renderExerciseList();
      renderMeasureChart();
      renderMeasureRecords();
      renderProfileHeader();
      renderRoutineExercises();
      renderCalendar();
      toast('Datos sincronizados con la nube ☁️');
    }
  } catch (e) {
    console.warn('No se pudo descargar desde Google Sheets:', e);
  }
}

// Inicialización de datos
restoreLocalData();
pullFromGoogleSheets();


