function handleImageFile(file, done){
  if(!file) return;
  if(!file.type || !file.type.startsWith('image/')){toast('Selecciona un archivo de imagen');return;}
  if(file.size > 12*1024*1024){toast('La imagen debe pesar menos de 12 MB');return;}
  const reader=new FileReader();
  reader.onload=()=>{
    const img=new Image();
    img.onload=()=>{
      const max=640, scale=Math.min(1,max/Math.max(img.width,img.height));
      const canvas=document.createElement('canvas');canvas.width=Math.max(1,Math.round(img.width*scale));canvas.height=Math.max(1,Math.round(img.height*scale));
      const ctx=canvas.getContext('2d');ctx.drawImage(img,0,0,canvas.width,canvas.height);
      const data=canvas.toDataURL('image/jpeg',0.82);
      if(data.length>2_500_000){toast('La imagen sigue siendo demasiado grande; prueba otra más pequeña');return;}
      done(data);
    };
    img.onerror=()=>toast('No se pudo leer esa imagen');
    img.src=reader.result;
  };
  reader.onerror=()=>toast('No se pudo abrir el archivo');
  reader.readAsDataURL(file);
}
