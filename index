/* ============================================================
   GRÁFICO DE BARRAS (HOME)
============================================================ */
const CHART_DATA = {
  dur: { data:[45,62,0,52,0,70,38], fmt:v => v + 'm',   label:'Duración' },
  vol: { data:[8200,6400,0,7100,0,9400,5200], fmt:v => (v/1000).toFixed(1) + 'k', label:'Volumen (kg)' },
  rep: { data:[62,48,0,55,0,74,40], fmt:v => v + '',    label:'Repeticiones' }
};
const DAYS = ['L','M','X','J','V','S','D'];
let currentFilter = 'dur';

function renderChart(filter){
  currentFilter = filter;
  const cfg = CHART_DATA[filter];
  const max = Math.max(...cfg.data);

  const container = document.getElementById('bars');
  container.innerHTML = '';

  cfg.data.forEach((val, i) => {
    const isEmpty = val === 0;
    const h = isEmpty ? 4 : Math.max(14, Math.round((val / max) * 100));

    const col = document.createElement('div');
    col.className = 'bar-col' + (isEmpty ? ' empty' : '');
    col.style.cursor='pointer';col.title=DAYS[i]+': '+(isEmpty?'sin datos':cfg.fmt(val));
    col.onclick=()=>{
      container.querySelectorAll('.bar-col').forEach(c=>c.classList.remove('selected'));
      col.classList.add('selected');
    };
    col.innerHTML = `
      <div class="bar-val">${isEmpty ? '—' : cfg.fmt(val)}</div>
      <div class="bar" style="height:0%"></div>
      <div class="bar-label">${DAYS[i]}</div>
    `;
    container.appendChild(col);

    requestAnimationFrame(() => {
      setTimeout(() => {
        col.querySelector('.bar').style.height = h + '%';
      }, 30 + i * 35);
    });
  });

  document.getElementById('chartSub').textContent =
    cfg.label + ' · ' + (document.querySelector('.period-chips .on')?.textContent || '3M');
}

function setFilter(btn){
  document.querySelectorAll('.filter-row button').forEach(b => b.classList.remove('on'));
  btn.classList.add('on');
  renderChart(btn.dataset.f);
}

function setPeriod(btn){
  document.querySelectorAll('.period-chips button').forEach(b => b.classList.remove('on'));
