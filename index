function toggleCheck(el){
  const row = el.closest('.set-row');
  const isOn = el.classList.toggle('on');
  row.classList.toggle('done', isOn);

  const w = parseFloat(row.dataset.w) || 0;
  const r = parseFloat(row.dataset.r) || 0;

  if(isOn){ volumeTotal += w * r; setsCompleted++; }
  else { volumeTotal -= w * r; setsCompleted--; }

  document.getElementById('volTotal').textContent = Math.round(volumeTotal).toLocaleString('es-ES');
  document.getElementById('setsDone').textContent = setsCompleted + '/18';

  if(isOn) startRest(120);
