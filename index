============================================================ */
let sessionStart = null;

function startSession(){
  const activeCards=[...document.querySelectorAll('#s-active .ex-card')];
  activeCards.forEach((card,i)=>{
    const ex=routineExercises[i];if(!ex)return;
    const src=(typeof ex.img==='string'&&ex.img.startsWith('data:image/'))?ex.img:(EXERCISE_IMAGES[ex.img]||EXERCISE_IMAGES.generic);
    const image=card.querySelector('.ex-image');
    if(image){image.style.backgroundImage=`url("${src}")`;image.style.backgroundSize='cover';image.style.backgroundPosition='center';image.style.backgroundRepeat='no-repeat';}
    const title=card.querySelector('.ec-head h3');if(title)title.textContent=ex.name;
    const subtitle=card.querySelector('.ec-head p');if(subtitle)subtitle.textContent=ex.muscle||'Ejercicio';
  });
  go('s-active');
  if(!sessionStart){ sessionStart = Date.now(); }
  document.getElementById('tabbar').classList.add('hide');
}

function endSession(){
  if(!sessionStart){toast('No hay una sesión activa');return;}
  const elapsed=Math.max(0,Math.floor((Date.now()-sessionStart)/1000));
  const rows=[...document.querySelectorAll('#s-active .set-row')];
  const completed=rows.filter(r=>r.querySelector('.check')?.classList.contains('done')||r.querySelector('.check')?.classList.contains('checked')).length;
  let volume=0;
  rows.forEach(r=>{const inputs=r.querySelectorAll('input.num-input');volume+=(parseFloat(inputs[0]?.value)||0)*(parseFloat(inputs[1]?.value)||0);});
  const fmtTime=n=>{const h=Math.floor(n/3600),m=Math.floor((n%3600)/60),sec=n%60;return h?`${h} h ${m} min`:`${m} min ${sec} s`;};
  const summary=`RESUMEN DEL ENTRENAMIENTO\n\nRutina: ${activeRoutineName||'Entrenamiento'}\nDuración: ${fmtTime(elapsed)}\nSeries completadas: ${completed}/${rows.length}\nVolumen estimado: ${Math.round(volume).toLocaleString('es-ES')} kg\n\n¿Quieres guardar esta sesión?\nAceptar = guardar · Cancelar = descartar`;
  if(confirm(summary)){
    const now=new Date();
    workoutLog.push({date:now.getFullYear()+'-'+String(now.getMonth()+1).padStart(2,'0')+'-'+String(now.getDate()).padStart(2,'0'),duration:Math.max(1,Math.round(elapsed/60)),volume:Math.round(volume),name:activeRoutineName||'Entrenamiento',sets:completed});
    persistLocalData();toast('Rutina guardada correctamente');
  }else toast('Sesión descartada');
  sessionStart=null;document.getElementById('sessionTimer').textContent='00:00:00';
  clearInterval(restInterval);document.getElementById('restFloat').classList.remove('open');tab('s-workout');
}

function tick(){
  if(!sessionStart) return;
  const total = Math.floor((Date.now() - sessionStart) / 1000);
  const h = String(Math.floor(total / 3600)).padStart(2,'0');
  const m = String(Math.floor((total % 3600) / 60)).padStart(2,'0');
  const s = String(total % 60).padStart(2,'0');
  const el = document.getElementById('sessionTimer');
  if(el) el.firstChild.textContent = `${h}:${m}:${s}`;
}
