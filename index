function addSet(btn){
  const card = btn.closest('.ex-card');
  const table = card.querySelector('.set-table');
  const rows = table.querySelectorAll('.set-row');
  const last = rows[rows.length - 1];
  const clone = last.cloneNode(true);

  const n = rows.length + 1;
