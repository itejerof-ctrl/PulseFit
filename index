let editingInput = null;
let kpBuffer = '';
let keypadMode = 'input';
let keypadRestIndex = null;

function openKeypad(input, label){
  keypadMode = 'input';
  editingInput = input;
  kpBuffer = input.value || '';
  document.getElementById('kpLabel').textContent = label;
  document.getElementById('kpValue').textContent = kpBuffer || '0';
  input.classList.add('editing');
  document.getElementById('keypad').classList.add('open');
  document.getElementById('backdrop').classList.add('open');
}

function openKeypadForRest(index, currentSeconds){
  keypadMode = 'rest';
  keypadRestIndex = index;
  editingInput = null;
  kpBuffer = String(currentSeconds);
  document.getElementById('kpLabel').textContent = 'Descanso (segundos)';
  document.getElementById('kpValue').textContent = kpBuffer;
  document.getElementById('keypad').classList.add('open');
  document.getElementById('backdrop').classList.add('open');
}

function kpKey(k){
  if(k === 'del'){
    kpBuffer = kpBuffer.slice(0, -1);
  } else if(k === '.'){
    if(!kpBuffer.includes('.')) kpBuffer = (kpBuffer || '0') + '.';
  } else {
    if(kpBuffer.length < 5) kpBuffer += k;
    if(kpBuffer.length > 1 && kpBuffer[0] === '0' && !kpBuffer.includes('.')) kpBuffer = kpBuffer.slice(1);
  }
  document.getElementById('kpValue').textContent = kpBuffer || '0';
}

function closeKeypad(apply){
  if (keypadMode === 'rest') {
    if (apply && keypadRestIndex !== null) {
      let seconds = parseInt(kpBuffer, 10);
      if (isNaN(seconds) || seconds < 0) seconds = 0;
      if (seconds > 900) seconds = 900;
      routineExercises[keypadRestIndex].restSeconds = seconds;
      renderRoutineExercises();
      toast('Descanso actualizado a ' + formatTime(seconds));
    }
    keypadRestIndex = null;
  } else {
    if(apply && editingInput){
      editingInput.value = kpBuffer || '0';
      const row = editingInput.closest('.set-row');
      if(row){
        const inputs = row.querySelectorAll('.num-input');
        row.dataset.w = inputs[0].value;
        row.dataset.r = inputs[1].value;
      }
    }
    if(editingInput) editingInput.classList.remove('editing');
    editingInput = null;
  }
  document.getElementById('keypad').classList.remove('open');
  document.getElementById('backdrop').classList.remove('open');
}

