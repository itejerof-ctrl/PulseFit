============================================================ */
const ROUTINE_CHART_DATA = {
  '3M':  { values:[4020,4240,4180,4520,4710,4880,5120], labels:['Ago','Sep','Oct'], change:'+18.4%', sub:'Últimos 3 meses' },
  '6M':  { values:[3640,3820,3760,4020,4280,4640,5120], labels:['May','Jul','Oct'], change:'+28.6%', sub:'Últimos 6 meses' },
  '1A':  { values:[3120,3280,3400,3560,3900,4380,5120], labels:['Nov','Feb','Oct'], change:'+39.1%', sub:'Último año' },
  'ALL': { values:[2400,2560,2780,3120,3640,4380,5120], labels:['2023','2025','2026'], change:'+53.2%', sub:'Todo el tiempo' }
};
let routinePeriod = '3M';

function renderRoutineChart(period){
  const d = ROUTINE_CHART_DATA[period];
  const values = d.values;
  const max = Math.max(...values);
  const min = Math.min(...values);
  const range = max - min || 1;
  const pad = range * 0.25;
  const lo = min - pad, hi = max + pad;
  const W = 300, H = 110, mx = 26, my = 16;
  const cw = W - mx*2, ch = H - my*2;
  const x = i => mx + (i/(values.length-1))*cw;
  const y = v => my + ch - ((v-lo)/(hi-lo))*ch;

  let path='';
  values.forEach((v,i)=>{ path += (i===0?`M${x(i)},${y(v)}`:` L${x(i)},${y(v)}`); });

  const firstX = x(0), lastX = x(values.length-1);
  const areaPath = `${path} L${lastX},${H-my} L${firstX},${H-my} Z`;

  let svg = `<defs>
    <linearGradient id="routineArea" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#8B5CF6" stop-opacity=".42"/>
      <stop offset="100%" stop-color="#8B5CF6" stop-opacity="0"/>
    </linearGradient>
    <linearGradient id="routineLine" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#3B82F6"/>
      <stop offset="100%" stop-color="#A78BFA"/>
    </linearGradient>
  </defs>`;
  svg += `<path d="${areaPath}" fill="url(#routineArea)"/>`;
  svg += `<path d="${path}" fill="none" stroke="url(#routineLine)" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/>`;

  values.forEach((v,i)=>{
    const cx = x(i), cy = y(v);
    const stroke = i < 3 ? '#3B82F6' : (i < 5 ? '#818CF8' : '#A78BFA');
    svg += `<circle cx="${cx}" cy="${cy}" r="6" fill="#0E0E16" stroke="${stroke}" stroke-width="2" data-chart-value="${v}" data-chart-label="Sesión ${i+1}" class="interactive-point" style="cursor:pointer"/>`;
  });

  const lblPositions = [0, Math.floor((values.length-1)/2), values.length-1];
  svg += d.labels.map((t,k)=>{
    const px = x(lblPositions[k]);
