function updateSetField(exIndex, setIndex, field, raw){
  const ex = routineExercises[exIndex];
  if (!ex || !ex.sets[setIndex]) return;
  const set = ex.sets[setIndex];

  let v = parseFloat(raw);
  if (isNaN(v) || v < 0) v = 0;

  if (field === 'weight') {
    set.weight = Math.round(v * 10) / 10;
  } else {
    set[field] = Math.round(v);
    if (set.repsMin > set.repsMax) {
      if (field === 'repsMin') set.repsMax = set.repsMin;
      else set.repsMin = set.repsMax;
    }
  }
}

function deleteRoutineSet(exIndex, setIndex){
